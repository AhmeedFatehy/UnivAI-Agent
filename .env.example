# Explicit runtime: integrated (default) or standalone.
UNIVAI_MODE=standalone
UNIVAI_ENV=development
# Optional; defaults to this repository's .standalone directory.
UNIVAI_STANDALONE_ROOT=

# Integrated main-repository paths and providers.
UNIVAI_INTEGRATION_ROOT=
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=course_materials
DENSE_EMBEDDING_MODEL=jinaai/jina-embeddings-v2-base-en
SPARSE_EMBEDDING_MODEL=Qdrant/bm25
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
LLM_MODEL=qwen3:4b-instruct
LLM_BASE_URL=http://localhost:11434
# Resilient fallback used when the primary model is unavailable.
LLM_FALLBACK_MODEL=qwen3:0.6b-instruct
LLM_FALLBACK_BASE_URL=http://localhost:11434
